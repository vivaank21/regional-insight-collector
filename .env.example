# ---------------------------------------------------------------------
# Regional Insight Collector — environment configuration
#
# Copy this file to `.env` and fill in real values.
# NEVER commit your actual .env file to version control.
# ---------------------------------------------------------------------

# Flask
SECRET_KEY=change-this-to-a-long-random-string
FLASK_DEBUG=False
FLASK_HOST=127.0.0.1
FLASK_PORT=5000

# Geolocation provider
# Default uses ip-api.com's free JSON endpoint, which needs no API key
# for light/non-commercial use. If you switch providers, set the
# matching values below and adjust geolocation.py accordingly.
GEOLOCATION_PROVIDER=ip-api
GEOLOCATION_API_URL=http://ip-api.com/json/
GEOLOCATION_API_KEY=
GEOLOCATION_TIMEOUT_SECONDS=4

# Reverse proxy trust
# Set TRUST_PROXY_HEADERS=True ONLY when this app is deployed behind a
# reverse proxy you control (e.g. nginx). TRUSTED_PROXY_COUNT should
# match the exact number of proxy hops in front of the app.
TRUST_PROXY_HEADERS=False
TRUSTED_PROXY_COUNT=1

# Development Mode
# Set DEV_MODE_MOCK_GEOLOCATION=True during local development to use mock
# geolocation data for localhost testing. This allows testing the full
# regional flow without a public IP. NEVER set this to True in production.
DEV_MODE_MOCK_GEOLOCATION=False

# Admin Panel
# Password to protect the /admin dashboard. Change this to a strong,
# unique password in production. Keep it secret and never commit the
# actual password to version control.
ADMIN_PASSWORD=admin-password-123
